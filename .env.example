# =========================================================
# GridPulse Intelligence
# Environment Configuration Template
# =========================================================

# -------------------------
# EIA Energy API
# -------------------------
EIA_API_KEY=

# -------------------------
# Weather / NOAA
# -------------------------
NOAA_USER_AGENT=GridPulseIntelligence/0.1

# -------------------------
# PostgreSQL
# -------------------------
POSTGRES_USER=gridpulse
POSTGRES_PASSWORD=
POSTGRES_DB=gridpulse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -------------------------
# Kafka
# -------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# -------------------------
# Local / Lakehouse Storage
# -------------------------
STORAGE_BACKEND=local
DATA_ROOT=./data

# -------------------------
# MLflow
# -------------------------
MLFLOW_TRACKING_URI=http://localhost:5000

# -------------------------
# OpenLineage
# -------------------------
OPENLINEAGE_URL=http://localhost:5000

# -------------------------
# FastAPI
# -------------------------
API_HOST=0.0.0.0
API_PORT=8000

# -------------------------
# Azure
# Configure later
# -------------------------
AZURE_STORAGE_ACCOUNT=
AZURE_CONTAINER_NAME=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=

# -------------------------
# Application
# -------------------------
APP_ENV=development
LOG_LEVEL=INFO
